# Track the quantification source tree; keep unrelated documents and local data out.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/README_committee.md
!/AGENTS.md
!/run_committee.py
!/run_vnpy.py
!/test_qlib.py
!/a_stock_committee/
!/bridge/
!/committee_config/
!/docs/
!/scripts/
!/tests/
!/trading/
!/webapp/
!/quant_learning_starter/

# Rebuildable dependencies and generated files.
**/env/
**/venv/
**/.venv*/
**/node_modules/
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.cache/
**/.ipynb_checkpoints/
**/.runtime/
**/.playwright-cli/
**/.pw-browsers/
**/dist/
**/build/
**/outputs/
**/*.py[cod]
**/*.tsbuildinfo
**/*.log
**/*.sqlite*
**/*.db
**/*.zip
**/*.7z
**/*.rar
**/*.exe
**/*.msi

# Local credentials and account/runtime storage must never be published.
**/.env
**/.env.*
!**/.env.example
!**/.env.template
!**/.env.sample
**/*.pem
**/*.pfx
**/*.p12
**/*.key
**/credentials.json
**/secrets.json
**/token.json
**/tokens.json
/webapp/storage/
/bridge/signals/

# Small, pinned baseline receipts required by the architecture documentation.
!/outputs/
/outputs/*
!/outputs/architecture_v2/
/outputs/architecture_v2/*
!/outputs/architecture_v2/baseline_*.json
!/outputs/architecture_v2/post_intent_*.json
