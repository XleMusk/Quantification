      "patch": "@@ -0,0 +1,31 @@\n+[project]\n+name = \"pydata-book\"\n+version = \"3.0.0\"\n+description = \"Code and materials for Python for Data Analysis, 3rd Edition\"\n+requires-python = \">=3.9\"\n+dependencies = [\n+    \"numpy\",\n+    \"pandas==2.0.3\",\n+    \"matplotlib\",\n+    \"lxml\",\n+    \"seaborn\",\n+    \"statsmodels\",\n+    \"scipy\",\n+    \"patsy\",\n+    \"scikit-learn\",\n+    \"beautifulsoup4\",\n+    \"jupyter\",\n+    \"ipython\",\n+    \"requests\",\n+    \"sqlalchemy\",\n+    \"pytz\",\n+]\n+\n+[project.optional-dependencies]\n+dev = [\n+    \"jupyter\",\n+]\n+\n+[build-system]\n+requires = [\"setuptools>=61.0\"]\n+build-backend = \"setuptools.build_meta\""
